{
  "name": "silk-ssh-terminal",
  "version": "0.3.1",
  "description": "SSH and local terminal with script-aware fonts and bounded output flow",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && node start.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && node tests/ui.cjs",
    "pack": "npm run build && node package.mjs",
    "dist": "npm run build && node package.mjs --zip"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.3.0",
    "katex": "^0.19.1",
    "marked": "^17.0.0",
    "node-pty": "1.1.0",
    "ssh-config": "^5.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "rcedit": "^5.0.2"
  },
  "productName": "Terminal"
}
